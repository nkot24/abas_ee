	<div class="wpb_single_image wpb_content_element vc_align_left  vc_custom_1614236029870" bis_skin_checked="1">
		
		<figure class="wpb_wrapper vc_figure">
			<div class="vc_single_image-wrapper   vc_box_border_grey" bis_skin_checked="1"><img loading="lazy" decoding="async" width="600" height="401" src="./kūpinātava_files/82150158_1_3-600x400.jpg" class="vc_single_image-img attachment-full" alt="" srcset="https://abas.lv/wp-content/uploads/2019/10/82150158_1_3-600x400-300x201@2x.jpg 600w, https://abas.lv/wp-content/uploads/2019/10/82150158_1_3-600x400-300x201.jpg 300w, https://abas.lv/wp-content/uploads/2019/10/82150158_1_3-600x400-377x251.jpg 377w" sizes="auto, (max-width: 600px) 100vw, 600px"></div>
