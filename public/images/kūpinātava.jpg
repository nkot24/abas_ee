body {
	font-family: Roboto Slab, sans-serif;
	font-size: 14px;
	line-height: 24px;
}
h1 {
	font-family: Oswald;
	font-size: 40px;
	line-height: 44px;
}
h2 {
	font-family: Oswald, sans-serif;
	font-size: 28px;
	line-height: 31px;
}
h3 {
	font-family: Oswald, sans-serif;
	font-size: 20px;
	line-height: 26px;
}
h4 {
	font-family: Oswald, sans-serif;
	font-size: 16px;
	line-height: 18px;
}
h5 {
	font-family: Oswald, sans-serif;
	font-size: 14px;
	line-height: 16px;
}
h6 {
	font-family: Oswald, sans-serif;
	font-size: 12px;
	line-height: 14px;
}

